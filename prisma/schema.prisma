datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FormStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum SubmissionStatus {
  PENDING
  PROCESSED
  FAILED
}

model Form {
  id          String        @id // Jotform Form ID
  title       String
  status      FormStatus    @default(ACTIVE)
  schemaCache Json?         @map("schema_cache")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  submissions Submission[]

  @@map("forms")
}

model Submission {
  id             String           @id // Jotform Submission ID
  formId         String           @map("form_id")
  rawPayload     Json             @map("raw_payload")
  normalizedData Json             @map("normalized_data")
  status         SubmissionStatus @default(PENDING)
  errorMessage   String?          @map("error_message")
  processedAt    DateTime?        @map("processed_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id])

  @@index([formId], name: "idx_submissions_form_id")
  @@index([status], name: "idx_submissions_status")
  @@map("submissions")
}

model WebhookLog {
  id           String   @id @default(uuid())
  formId       String?  @map("form_id")
  submissionId String?  @map("submission_id")
  headers      Json?
  payload      Json?
  receivedAt   DateTime @default(now()) @map("received_at")

  @@map("webhook_logs")
}
